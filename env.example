# Database Connection Details
DB_HOST=
DB_PORT=
DB_PASS=
PMM_MONITOR_USER=pmm_monitor

#Droplet Configuration
SINK_IP=
# Public DNS hostname for the sink Droplet. rsyslog presents a Let's Encrypt cert for
# this name and it is the destination configured in DO log forwarding. It MUST resolve
# publicly to SINK_IP (an A record) so certbot's HTTP-01 challenge succeeds.
# For a quick IP-only test you can use sslip.io (e.g. 142-93-154-42.sslip.io) --
# see docs/sslip.md. In production use a real domain you control (e.g. logs.example.com).
SINK_HOSTNAME=
LETSENCRYPT_EMAIL=


#PMM Server, run outside the sink droplet.
PMM_SERVER=
PMM_TOKEN=

# DO Managed DB CA certificate (Connection Details -> Download CA certificate
# in the DO control panel). Paste its contents into certs/do-ca.crt in this repo
# directory -- do NOT set a variable here for that; DO_CA_BUNDLE below is only
# the destination setup.sh installs it to on this Droplet, left at its default.
# DO_CA_BUNDLE=/etc/mysql_sink/do-ca.crt


