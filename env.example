# Copy to .env (same directory as setup.sh) and fill in. .env is gitignored and
# setup.sh keeps it at mode 0600. One .env per sink Droplet, one sink per DB
# endpoint — see RUNBOOK "Monitoring multiple Managed MySQL endpoints with one
# PMM Server" for which values must differ between sinks.

# --- Database ---------------------------------------------------------------
# The endpoint this sink monitors (a cluster's primary, or one read-only replica).
DB_HOST=
DB_PORT=
DB_PASS=
PMM_MONITOR_USER=pmm_monitor
# Port the local socat proxy listens on (127.0.0.1). pmm-agent and every probe
# connect here. Defaults to DB_PORT; only change it if that port is taken locally.
# LOCAL_PROXY_PORT=25060

# DO Managed DB CA certificate (Connection Details -> Download CA certificate
# in the DO control panel). Paste its contents into certs/do-ca.crt in this repo
# directory -- do NOT set a variable here for that; DO_CA_BUNDLE below is only
# the destination setup.sh installs it to on this Droplet, left at its default.
# DO_CA_BUNDLE=/etc/mysql_sink/do-ca.crt

# --- Sink -------------------------------------------------------------------
SINK_IP=
# Public DNS hostname for the sink Droplet. rsyslog presents a Let's Encrypt cert for
# this name and it is the destination configured in DO log forwarding. It MUST resolve
# publicly to SINK_IP (an A record) so certbot's HTTP-01 challenge succeeds.
# For a quick IP-only test you can use sslip.io (e.g. 142-93-154-42.sslip.io) --
# see docs/sslip.md. In production use a real domain you control (e.g. logs.example.com).
SINK_HOSTNAME=
LETSENCRYPT_EMAIL=

# --- PMM Server -------------------------------------------------------------
# Runs outside the sink droplet. Bare IP/hostname (no scheme, no port).
PMM_SERVER=
# Service-account token (glsa_...), one per sink so each can be revoked on its
# own. Leave blank on a never-logged-into PMM (admin/admin) to have setup.sh
# mint one for a service account named sink-<PMM_NODE_NAME>.
PMM_TOKEN=

# --- PMM identity -----------------------------------------------------------
# Both must be unique on the PMM Server when more than one sink reports to it.
# Allowed characters: letters, digits, '.', '_' and '-'.
#
# Service name shown in PMM (QAN, dashboards). Default: do-managed-mysql.
# PMM_SERVICE_NAME=prod-primary
#
# PMM node name for this Droplet. Default: the Droplet's `hostname` (what
# pmm-admin itself uses). setup.sh refuses to register over a node with this
# name that belongs to another machine...
# PMM_NODE_NAME=sink-prod-primary
# ...unless this is 1 (e.g. replacing a deleted Droplet's stale node). Also
# forces re-registration when this sink is already registered and connected.
# PMM_FORCE_REREGISTER=0

# --- PMM labels (optional) --------------------------------------------------
# Passed to `pmm-admin add mysql` only when set; use them to group and compare
# endpoints in PMM (e.g. primary vs replica, or old vs new clusters).
# PMM_ENVIRONMENT=production
# PMM_CLUSTER=prod
# PMM_REPLICATION_SET=prod
# PMM_CUSTOM_LABELS=role=primary,edition=standard
